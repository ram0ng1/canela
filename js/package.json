{
    "name": "@ramon/canela",
    "version": "0.1.0",
    "private": true,
    "prettier": "@flarum/prettier-config",
    "devDependencies": {
        "@flarum/prettier-config": "^1.0.0",
        "@typescript-eslint/parser": "^8.72.0",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "flarum-tsconfig": "^2.0.0",
        "flarum-webpack-config": "^3.1.0",
        "lucide": "0.555.0",
        "prettier": "^3.4.2",
        "typescript": "^7.0.2",
        "webpack": "^5.112.1",
        "webpack-cli": "^7.3.1"
    },
    "scripts": {
        "predev": "node scripts/ensure-deps.cjs",
        "dev": "webpack --mode development --watch",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "prebuild": "node scripts/ensure-deps.cjs",
        "build": "npm run lint && webpack --mode production",
        "analyze": "cross-env ANALYZER=true npm run build",
        "format": "prettier --write src",
        "format-check": "prettier --check src",
        "clean-typings": "npx --yes rimraf dist-typings && mkdir dist-typings",
        "build-typings": "npm run clean-typings && ([ -e src/@types ] && cp -r src/@types dist-typings/@types || true) && tsc && npm run post-build-typings",
        "post-build-typings": "find dist-typings -type f -name '*.d.ts' -print0 | xargs -0 sed -i 's,../src/@types,@types,g'",
        "check-typings": "tsc --noEmit --emitDeclarationOnly false",
        "check": "npm run format-check && npm run check-typings && npm run lint"
    },
    "dependencies": {
        "html-to-image": "1.11.13"
    }
}
