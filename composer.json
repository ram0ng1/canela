{
    "name": "ramon/canela",
    "description": "An unofficial theme for Flarum 2.",
    "keywords": [
        "flarum",
        "theme"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/ram0ng1/canela",
    "authors": [
        {
            "name": "Ramon Guilherme",
            "email": "ramon@ramonguilherme.com.br",
            "homepage": "https://ramonguilherme.com.br",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ram0ng1/canela/issues",
        "source": "https://github.com/ram0ng1/canela",
        "forum": "https://github.com/ram0ng1/canela/discussions"
    },
    "funding": [
        {
            "type": "website",
            "url": "https://donate.stripe.com/fZe5o66nebkf39S28a"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0"
    },
    "require-dev": {
        "flarum/tags": "^2.0.0",
        "flarum/messages": "^2.0.0",
        "phpunit/phpunit": "^11.5 || ^12.5.22 || ^13.2.0",
        "phpstan/phpstan": "^2.1",
        "roave/security-advisories": "dev-latest",
        "fof/pages": "^2.0",
        "fof/polls": "^3.0",
        "ernestdefoe/wardrobe": "^1.1",
        "ramon/chat": "^0.3",
        "flarum/testing": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/suspend": "^2.0.0",
        "flarum/flags": "^2.0.0",
        "flarum/likes": "^2.0.0",
        "flarum/mentions": "^2.0.0",
        "flarum/sticky": "^2.0.0",
        "flarum/subscriptions": "^2.0.0",
        "flarum/lock": "^2.0.0",
        "flarum/approval": "^2.0.0"
    },
    "suggest": {
        "flarum/tags": "Categories and tags in the sidebar, the discussion list and the tags page.",
        "flarum/subscriptions": "\"Following\" link and the discussion notification bell.",
        "flarum/likes": "Likes in the topic map and the profile summary.",
        "flarum/messages": "\"My messages\" link in the sidebar.",
        "fof/polls": "Polls with result bars and vote counts.",
        "fof/best-answer": "Accepted solution right below the first post.",
        "fof/reactions": "Reactions with an emoji summary on the post bar.",
        "fof/upload": "Image and file uploads in the composer.",
        "fof/follow-tags": "Follow/mute categories and tags.",
        "fof/split": "Split discussions.",
        "fof/merge-discussions": "Merge discussions.",
        "fof/ignore-users": "Ignore users.",
        "fof/terms": "Terms and guidelines at sign-up.",
        "fof/formatting": "Spoiler, details and more formatting.",
        "fof/links": "Custom links.",
        "fof/oauth": "Social login.",
        "fof/discussion-thumbnail": "Thumbnails in the discussion list."
    },
    "autoload": {
        "psr-4": {
            "Ramon\\Canela\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ramon\\Canela\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse --memory-limit=2G",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis",
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "extra": {
        "flarum-extension": {
            "title": "Canela",
            "category": "theme",
            "optional-dependencies": [
                "flarum/tags",
                "flarum/sticky",
                "flarum/subscriptions",
                "flarum/likes",
                "flarum/mentions",
                "flarum/lock",
                "flarum/approval",
                "flarum/flags",
                "flarum/messages",
                "flarum/realtime",
                "flarum/suspend",
                "flarum/nicknames",
                "fof/polls",
                "fof/best-answer",
                "fof/reactions",
                "fof/upload",
                "fof/follow-tags",
                "fof/split",
                "fof/merge-discussions",
                "fof/ignore-users",
                "fof/terms",
                "fof/formatting",
                "fof/links",
                "fof/oauth",
                "fof/discussion-thumbnail"
            ],
            "icon": {
                "image": "icon.png",
                "backgroundColor": "#fff",
                "backgroundSize": "cover"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": true,
                "css": true,
                "locale": true,
                "typescript": true
            }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
