root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,neon}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[js/**.{ts,tsx,js,mjs,cjs,json,less}]
indent_size = 2

[less/**.less]
indent_size = 2
